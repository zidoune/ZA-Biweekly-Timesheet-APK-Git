rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny all unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(userId) && request.resource.data.userId == userId;
      allow delete: if isOwner(userId);

      match /projects/{projectId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(projectId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }

      match /entries/{entryId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(entryId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }

      match /daysOff/{dayOffId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(dayOffId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }

      match /managedEmployees/{managedEmployeeId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(managedEmployeeId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
